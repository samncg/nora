# Copy this file to .env and fill in your values.

# Discord bot token (Developer Portal -> Bot -> Reset Token).
DISCORD_TOKEN=

# Optional: needed only for gated Hugging Face repos (google/gemma-*).
HF_TOKEN=

# Optional: only needed when provider.mode is "openrouter" in config.yaml.
# You can also paste the key from the tray icon instead of editing this file.
OPENROUTER_API_KEY=
